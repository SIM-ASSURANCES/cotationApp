# =====================================================================
# Modèle de configuration du générateur (generateur/).
# Copier ce fichier en « .env » dans le même dossier, puis compléter.
# Le fichier .env n'est JAMAIS commité (voir le .gitignore à la racine).
# Une valeur manquante ou invalide arrête le service au démarrage ;
# une valeur vide compte comme manquante ; une variable inconnue
# (faute de frappe) est refusée.
# Chemins Windows : les entourer d'apostrophes simples ('C:\...') pour
# que les barres obliques inverses soient lues telles quelles.
# =====================================================================

# OBLIGATOIRE. Secret partagé avec l'application (en-tête
# X-Generateur-Secret), 32 caractères minimum. Doit être IDENTIQUE à
# GENERATEUR_SECRET dans app/.env. Pour en créer un :
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
GENERATEUR_SECRET=

# OBLIGATOIRE. Chemin absolu de l'exécutable LibreOffice.
#   Windows : 'C:\Program Files\LibreOffice\program\soffice.com'
#   Linux   : /usr/bin/soffice
LIBREOFFICE_CHEMIN='C:\Program Files\LibreOffice\program\soffice.com'

# OBLIGATOIRE. Dossier absolu où le générateur écrira les documents
# produits, HORS du dépôt Git (ils contiendront des données clients).
#   Windows : 'C:\sim-documents\sortie'   Linux : /var/lib/sim-documents/sortie
DOSSIER_SORTIE=

# OBLIGATOIRE. Dossier absolu du profil LibreOffice dédié au service :
# évite tout conflit avec un LibreOffice ouvert par un utilisateur.
#   Windows : 'C:\sim-documents\profil-libreoffice'
#   Linux   : /var/lib/sim-documents/profil-libreoffice
PROFIL_LIBREOFFICE=

# Délai maximal d'une conversion en PDF, en secondes (défaut : 60).
# Servira à interrompre une conversion bloquée (conversion à venir).
DELAI_CONVERSION_S=60

# Adresse et port d'écoute (défauts : 127.0.0.1 et 8001).
# 127.0.0.1 = machine locale uniquement : le générateur n'est jamais
# exposé au réseau. Doit correspondre à GENERATEUR_URL dans app/.env.
GENERATEUR_HOTE=127.0.0.1
GENERATEUR_PORT=8001
