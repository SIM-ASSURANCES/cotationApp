// Schéma de la base PostgreSQL de SIM Documents.
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Client généré dans src/generated/ (ignoré par Git), recréé par `npx prisma generate`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 : l'adresse de la base se règle dans prisma7.config.ts, plus ici.
}

/// Paramètre du cahier des charges, historisé : changer une valeur, c'est ajouter
/// une ligne avec une nouvelle date d'effet, jamais modifier une ligne existante.
model Parametre {
  id        Int      @id @default(autoincrement())
  /// Identifiant du paramètre.
  cle       String
  /// Valeur en texte, convertie par le code qui la lit (un montant en Decimal, jamais en flottant).
  valeur    String
  /// Date à partir de laquelle la valeur s'applique.
  dateEffet DateTime @map("date_effet") @db.Date
  creeLe    DateTime @default(now()) @map("cree_le")
  /// Auteur de la saisie (identifiant de l'utilisateur, en attendant l'authentification).
  creePar   String   @map("cree_par")

  @@unique([cle, dateEffet])
  @@map("parametres")
}

/// Profil du CDC §4 (Commercial, Technique...). Les codes sont définis dans src/domaine/droits.ts.
model Profil {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  libelle      String
  droits       ProfilDroit[]
  utilisateurs Utilisateur[]

  @@map("profils")
}

/// Droit d'un profil sur une action : modifiable par l'Admin système (« droits paramétrables »).
model ProfilDroit {
  profilId Int    @map("profil_id")
  /// Code d'action (CREER_COTATION...), voir src/domaine/droits.ts.
  action   String
  /// Code de niveau (AUCUN, LECTURE, DEMANDE, OUI_SOUS_SEUIL, OUI, VALIDE).
  niveau   String
  profil   Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@id([profilId, action])
  @@map("profils_droits")
}

/// Compte de connexion au back-office. Jamais supprimé : désactivé (actif = false), pour garder l'historique.
model Utilisateur {
  id                    Int            @id @default(autoincrement())
  /// En minuscules (normalisé avant l'enregistrement).
  identifiant           String         @unique
  nom                   String
  /// Empreinte scrypt du mot de passe (format « scrypt$N$r$p$sel$empreinte »), jamais le mot de passe.
  motDePasseHash        String         @map("mot_de_passe_hash")
  profilId              Int            @map("profil_id")
  actif                 Boolean        @default(true)
  /// Vrai après une création ou une réinitialisation par l'administrateur : changement obligatoire.
  doitChangerMotDePasse Boolean        @default(false) @map("doit_changer_mot_de_passe")
  echecsConsecutifs     Int            @default(0) @map("echecs_consecutifs")
  verrouilleJusqua      DateTime?      @map("verrouille_jusqua")
  derniereConnexionLe   DateTime?      @map("derniere_connexion_le")
  creeLe                DateTime       @default(now()) @map("cree_le")
  modifieLe             DateTime       @updatedAt @map("modifie_le")
  profil                Profil         @relation(fields: [profilId], references: [id], onDelete: Restrict)
  evenements            JournalAudit[]

  @@map("utilisateurs")
}

/// Journal d'audit (CDC §15.4) : ajout seul. Un déclencheur PostgreSQL refuse UPDATE, DELETE et
/// TRUNCATE (voir la migration). Écrit par une seule fonction : src/serveur/audit.ts.
model JournalAudit {
  id                     BigInt       @id @default(autoincrement())
  horodatage             DateTime     @default(now())
  utilisateurId          Int?         @map("utilisateur_id")
  /// Copie de l'identifiant au moment de l'action : lisible même si le compte évolue.
  utilisateurIdentifiant String?      @map("utilisateur_identifiant")
  action                 String
  objetType              String?      @map("objet_type")
  objetId                String?      @map("objet_id")
  avant                  Json?
  apres                  Json?
  adresseIp              String?      @map("adresse_ip")
  utilisateur            Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([horodatage])
  @@index([action])
  @@index([utilisateurId])
  @@map("journal_audit")
}

/// Branche fiscale (D21) : liste paramétrable, clé des taux de taxe et des produits. Le code ne change
/// jamais ; le libellé et l'état actif se modifient (modifications journalisées). Une branche désactivée
/// garde ses taux et ses produits, mais n'en reçoit plus de nouveaux.
model Branche {
  code     String    @id
  libelle  String
  actif    Boolean   @default(true)
  creeLe   DateTime  @default(now()) @map("cree_le")
  creePar  String    @map("cree_par")
  taxes    Taxe[]
  produits Produit[]

  @@map("branches")
}

/// Intermédiaire (CDC §10.1, session 6.0, H71 fermée) : courtier ou agent qui apporte l'affaire. Code immuable, jamais
/// supprimé (désactivé à la place) ; nom et rôle modifiables, chaque changement journalisé.
model Intermediaire {
  id        Int                     @id @default(autoincrement())
  code      String                  @unique
  nom       String
  /// Rôle repris dans les documents (apporteur, gestionnaire…).
  role      String
  actif     Boolean                 @default(true)
  creeLe    DateTime                @default(now()) @map("cree_le")
  creePar   String                  @map("cree_par")
  cotations CotationIntermediaire[]

  @@map("intermediaires")
}

/// Intermédiaire choisi sur une cotation (0 à 2, ordre 1 ou 2). Code, nom et rôle copiés au moment du choix (T10).
model CotationIntermediaire {
  cotationId      Int           @map("cotation_id")
  ordre           Int           @db.SmallInt
  intermediaireId Int           @map("intermediaire_id")
  code            String
  nom             String
  role            String
  cotation        Cotation      @relation(fields: [cotationId], references: [id], onDelete: Restrict)
  intermediaire   Intermediaire @relation(fields: [intermediaireId], references: [id], onDelete: Restrict)

  @@id([cotationId, ordre])
  @@unique([cotationId, intermediaireId], map: "cotations_intermediaires_unique")
  @@index([intermediaireId])
  @@map("cotations_intermediaires")
}

/// Taux de taxe (CDC §8.3, D18), historisé : clé (branche, type de contrat, date d'effet). Une ligne en
/// vigueur ne se modifie pas, sauf sa clôture (date de fin posée une fois). Pour une même clé, deux
/// périodes ne se chevauchent jamais : contrainte d'exclusion PostgreSQL (voir la migration).
model Taxe {
  id             Int       @id @default(autoincrement())
  branche        String
  brancheFiscale Branche   @relation(fields: [branche], references: [code], onDelete: Restrict, onUpdate: Restrict)
  /// INDIVIDUEL, FAMILLE, GROUPE, GROUPE_OUVERT, ou null : tous types de contrat.
  typeContrat    String?   @map("type_contrat")
  /// En pourcentage : 1.5 pour 1,5 %. Null seulement pour une ligne à taux mixte.
  tauxPourcent   Decimal?  @map("taux_pourcent") @db.Decimal(9, 6)
  /// Plusieurs taux dans un même contrat (incendie / dommages aux biens) : calcul refusé.
  tauxMixte      Boolean   @default(false) @map("taux_mixte")
  commentaire    String?
  /// NETTE_ACCESSOIRES (défaut du CDC) ou NETTE.
  assiette       String    @default("NETTE_ACCESSOIRES")
  dateEffet      DateTime  @map("date_effet") @db.Date
  dateFin        DateTime? @map("date_fin") @db.Date
  creeLe         DateTime  @default(now()) @map("cree_le")
  creePar        String    @map("cree_par")

  @@index([branche])
  @@map("taxes")
}

/// Produit d'assurance (CDC §2.3, §7). Aucun produit n'est codé en dur : tout vient d'ici.
model Produit {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  libelle        String
  gamme          String
  /// Branche fiscale : clé de la table des taxes (liste paramétrable, table branches).
  branche        String
  brancheFiscale Branche          @relation(fields: [branche], references: [code], onDelete: Restrict, onUpdate: Restrict)
  actif          Boolean          @default(true)
  creeLe         DateTime         @default(now()) @map("cree_le")
  creePar        String           @map("cree_par")
  versions       ProduitVersion[]
  cotations      Cotation[]
  modeles        Modele[]
  factures       Facture[]

  @@map("produits")
}

/// Fiche de paramétrage d'un produit à partir d'une date d'effet. HISTORISÉE : on ajoute une version,
/// on ne modifie jamais une version en vigueur (déclencheur PostgreSQL, voir la migration).
model ProduitVersion {
  id                          Int       @id @default(autoincrement())
  produitId                   Int       @map("produit_id")
  dateEffet                   DateTime  @map("date_effet") @db.Date
  arrondiPrecision            Int       @map("arrondi_precision")
  arrondiSens                 String    @map("arrondi_sens")
  arrondiNiveau               String    @map("arrondi_niveau")
  arrondiComposante           String    @map("arrondi_composante")
  prorataActif                Boolean   @map("prorata_actif")
  primeMinimale               Decimal?  @map("prime_minimale") @db.Decimal(18, 6)
  fractionnementTranchesMax   Int       @default(1) @map("fractionnement_tranches_max")
  /// Tableau JSON de pourcentages en texte (["40","30","30"]), ou null : tranches égales.
  fractionnementRepartition   Json?     @map("fractionnement_repartition")
  fractionnementDecalagesMois Json?     @map("fractionnement_decalages_mois")
  fraisFractionnement         Decimal   @default(0) @map("frais_fractionnement") @db.Decimal(18, 6)
  validiteMois                Int       @default(3) @map("validite_mois")
  formulesMax                 Int       @default(3) @map("formules_max")
  seuilValidationTtc          Decimal?  @map("seuil_validation_ttc") @db.Decimal(18, 6)
  /// Mode de tarification (session 6.2a) : FORMULE (prime unitaire × effectif, calcul automatique) ou GARANTIES (prime
  /// composée par la Technique ; le calcul automatique est refusé). Une version ne se modifie pas : la CHECK de la base
  /// n'admet que ces deux valeurs, et tout ce qui n'est pas exactement FORMULE est refusé par le code (jamais l'inverse).
  modeTarification            String    @default("FORMULE") @map("mode_tarification")
  /// Garanties du produit (session 6.2b) : [{ libelle, branche|null }] proposées à la composition de la prime ; vide : saisie libre.
  garanties                   Json      @default("[]")
  /// Faux : la composition n'accepte que les libellés de la liste des garanties.
  garantiesSaisieLibre        Boolean   @default(true) @map("garanties_saisie_libre")
  /// Références contractuelles (CDC §7) : code du modèle de CG (et de CS) joint au contrat, et visa
  /// cité dans les CP. À l'assemblage, ce visa doit être celui des CG jointes (contrôle bloquant, §6.8).
  cgModeleCode                String?   @map("cg_modele_code")
  cgVisa                      String?   @map("cg_visa")
  csModeleCode                String?   @map("cs_modele_code")
  csVisa                      String?   @map("cs_visa")
  creeLe                      DateTime  @default(now()) @map("cree_le")
  creePar                     String    @map("cree_par")
  produit                     Produit   @relation(fields: [produitId], references: [id], onDelete: Restrict)
  formules                    Formule[]

  @@unique([produitId, dateEffet])
  @@map("produit_versions")
}

/// Formule d'une version de produit (Solo, Famille, taux 70 %...). Prime unitaire avec décimales (CDC §8.5).
model Formule {
  id               Int            @id @default(autoincrement())
  produitVersionId Int            @map("produit_version_id")
  code             String
  libelle          String
  tauxCouverture   Decimal?       @map("taux_couverture") @db.Decimal(6, 3)
  primeUnitaire    Decimal        @map("prime_unitaire") @db.Decimal(18, 6)
  /// AUCUN, FIXE, PAR_TETE, PAR_FAMILLE ou POURCENT.
  accessoireMode   String         @map("accessoire_mode")
  accessoireValeur Decimal        @default(0) @map("accessoire_valeur") @db.Decimal(18, 6)
  /// Âges limites de la formule, en années révolues (session 5a, contrôle de l'import en masse : H62). Null : pas de limite.
  ageMin           Int?           @map("age_min")
  ageMax           Int?           @map("age_max")
  version          ProduitVersion @relation(fields: [produitVersionId], references: [id], onDelete: Restrict)

  @@unique([produitVersionId, code])
  @@map("formules")
}

/// Client enregistré (souscripteur connu). Un prospect, lui, se saisit librement sur la cotation (CDC §9.1).
model Client {
  id                    Int        @id @default(autoincrement())
  /// PHYSIQUE ou MORALE (dictionnaire souscripteur.type).
  type                  String
  nom                   String
  prenoms               String     @default("")
  raisonSociale         String     @default("") @map("raison_sociale")
  telephone             String     @default("")
  email                 String     @default("")
  adresse               String     @default("")
  /// Compléments du souscripteur (dictionnaire §6.3.2, session 4a) : copiés dans la cotation avec le reste.
  numIdentification     String     @default("") @map("num_identification")
  dateNaissance         DateTime?  @map("date_naissance") @db.Date
  lieuNaissance         String     @default("") @map("lieu_naissance")
  profession            String     @default("")
  activite              String     @default("")
  employeur             String     @default("")
  bp                    String     @default("")
  localite              String     @default("")
  sousPrefecture        String     @default("") @map("sous_prefecture")
  whatsapp              String     @default("")
  mobileMoney           String     @default("") @map("mobile_money")
  situationMatrimoniale String     @default("") @map("situation_matrimoniale")
  nbEnfants             Int?       @map("nb_enfants")
  groupeSanguin         String     @default("") @map("groupe_sanguin")
  creeLe                DateTime   @default(now()) @map("cree_le")
  creePar               String     @map("cree_par")
  cotations             Cotation[]

  @@map("clients")
}

/// Compteurs de numérotation (CDC §11.4) : un par type de document et par année (« COT-2026 »).
/// Incrémenté dans la transaction de l'émission : annulée, elle ne laisse aucun trou.
model Sequence {
  cle    String @id
  valeur Int

  @@map("sequences")
}

/// Motifs de refus d'une cotation : liste paramétrable (CDC §9.3).
model MotifRefus {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)

  @@map("motifs_refus")
}

/// Cotation (CDC §9). Brouillon et « À valider » se modifient ; dès « Émise », les données sont FIGÉES
/// (déclencheur PostgreSQL) : seuls le statut et l'issue (acceptation, refus) évoluent.
model Cotation {
  id                Int                     @id @default(autoincrement())
  /// COT-AAAA-MM-NNNN : attribué à l'émission seulement (un brouillon n'a pas de numéro).
  numero            String?                 @unique
  /// BROUILLON, A_VALIDER, EMISE, ACCEPTEE, REFUSEE ou EXPIREE.
  statut            String
  produitId         Int                     @map("produit_id")
  /// Date d'effet de la version du produit utilisée pour le calcul.
  versionDateEffet  DateTime                @map("version_date_effet") @db.Date
  clientId          Int?                    @map("client_id")
  /// Dictionnaire souscripteur.* (copie : une cotation émise ne bouge pas si le client est modifié).
  souscripteur      Json
  dateEffet         DateTime                @map("date_effet") @db.Date
  dateEcheance      DateTime                @map("date_echeance") @db.Date
  nombreTranches    Int                     @default(1) @map("nombre_tranches")
  /// [{ code, effectif, primeTarif, primeForcee|null }]
  lignes            Json
  motifForcage      String?                 @map("motif_forcage")
  assures           Json                    @default("[]")
  /// Bénéficiaires et contacts d'urgence (dictionnaire §6.3.2, session 4a). Null : cotation d'avant la 4a,
  /// où ces données n'étaient pas saisies (« jamais fournies », D19) ; [] : saisies et laissées vides.
  beneficiaires     Json?
  contactsUrgence   Json?                   @map("contacts_urgence")
  risque            Json                    @default("{}")
  /// INDIVIDUEL, FAMILLE, GROUPE ou GROUPE_OUVERT (police.type_contrat). Choisissait le taux avant la session 6.0 (D18).
  /// Null pour une cotation créée avant la session 4.0.
  typeContrat       String?                 @map("type_contrat")
  /// Régime de taxe (INDIVIDUEL ou GROUPE) : il sélectionne le taux (session 6.0, H29 fermée). Null avant la session 6.0.
  regimeTaxe        String?                 @map("regime_taxe")
  /// Entrée complète du moteur de calcul (montants en texte) : permet de recalculer à l'identique.
  donneesCalcul     Json?                   @map("donnees_calcul")
  /// Montants arrondis par formule et en total (texte).
  resultat          Json?
  ttcTotal          Decimal?                @map("ttc_total") @db.Decimal(18, 2)
  echeancier        Json?
  /// ["PRIME_FORCEE", "SEUIL_DEPASSE"] : pourquoi la validation est exigée.
  raisonsValidation Json                    @default("[]") @map("raisons_validation")
  auteurId          Int                     @map("auteur_id")
  auteurIdentifiant String                  @map("auteur_identifiant")
  /// Utilisateurs qui ont créé ou modifié le brouillon (H9) : aucun d'eux ne peut valider la cotation.
  contributeurs     Int[]                   @default([])
  valideParId       Int?                    @map("valide_par_id")
  valideLe          DateTime?               @map("valide_le")
  dateEtablissement DateTime?               @map("date_etablissement") @db.Date
  dateValidite      DateTime?               @map("date_validite") @db.Date
  emiseLe           DateTime?               @map("emise_le")
  formulesRetenues  Json?                   @map("formules_retenues")
  accepteeLe        DateTime?               @map("acceptee_le")
  motifRefusCode    String?                 @map("motif_refus_code")
  refusCommentaire  String?                 @map("refus_commentaire")
  /// Composition manuelle de la prime (produit en mode GARANTIES, session 6.2b) : qui, quand, pourquoi. Les lignes sont dans `donneesCalcul`.
  compositionParId  Int?                    @map("composition_par_id")
  compositionPar    String?                 @map("composition_par")
  compositionLe     DateTime?               @map("composition_le")
  compositionMotif  String?                 @map("composition_motif")
  creeLe            DateTime                @default(now()) @map("cree_le")
  modifieLe         DateTime                @updatedAt @map("modifie_le")
  produit           Produit                 @relation(fields: [produitId], references: [id], onDelete: Restrict)
  client            Client?                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  police            Police?
  intermediaires    CotationIntermediaire[]

  @@index([statut])
  @@index([dateValidite])
  @@index([produitId])
  @@map("cotations")
}

/// Police créée à l'acceptation d'une cotation (CDC §9.4). Le numéro est attribué par SIM et SAISI
/// (H10, D18) : jamais généré par le module ; unique ; format contrôlé par un paramètre (H31).
model Police {
  id               Int                 @id @default(autoincrement())
  numero           String              @unique
  /// INDIVIDUEL, FAMILLE, GROUPE ou GROUPE_OUVERT (police.type_contrat). Null avant la session 4.0.
  typeContrat      String?             @map("type_contrat")
  cotationId       Int                 @unique @map("cotation_id")
  produitCode      String              @map("produit_code")
  souscripteur     Json
  assures          Json
  /// Voir Cotation.beneficiaires : null = jamais fournis (police d'avant la 4a).
  beneficiaires    Json?
  contactsUrgence  Json?               @map("contacts_urgence")
  risque           Json
  formulesRetenues Json                @map("formules_retenues")
  donneesCalcul    Json                @map("donnees_calcul")
  resultat         Json
  ttcTotal         Decimal             @map("ttc_total") @db.Decimal(18, 2)
  echeancier       Json
  dateEffet        DateTime            @map("date_effet") @db.Date
  dateEcheance     DateTime            @map("date_echeance") @db.Date
  creeLe           DateTime            @default(now()) @map("cree_le")
  creePar          String              @map("cree_par")
  cotation         Cotation            @relation(fields: [cotationId], references: [id], onDelete: Restrict)
  /// Police de groupe : historique des listes d'adhérents (incorporations, retraits).
  adherents        AdherentsVersion[]
  /// Demandes de validation de l'émission du contrat (TTC au-dessus du seuil du produit, CDC §4.1).
  validations      ValidationContrat[]
  /// Factures et avoirs de la police (CDC §11, session 4b).
  factures         Facture[]
  /// Imports en masse d'adhérents (CDC §13, session 5a).
  lots             LotImport[]
  /// Tâches de la police (H64) : pièces à émettre après un import en masse.
  taches           TachePolice[]
  /// Avance de la police (session 6.0, H33, H47) : trop-perçus, reports, imputations, restitutions.
  mouvementsAvance MouvementAvance[]

  @@map("polices")
}

/// Liste des adhérents d'une police de groupe (CDC §10.2, D22), par VERSIONS en ajout seul : la liste
/// courante est celle de la dernière version. La version 1 est la liste de la cotation acceptée.
model AdherentsVersion {
  id        Int      @id @default(autoincrement())
  policeId  Int      @map("police_id")
  numero    Int
  /// INITIALE, INCORPORATION ou RETRAIT.
  motif     String
  /// Date à laquelle le changement prend effet.
  dateEffet DateTime @map("date_effet") @db.Date
  /// Liste COMPLÈTE après le changement ([{ ordre, nom_prenoms, … }], noms du dictionnaire).
  adherents Json
  /// Ordres des adhérents ajoutés ou retirés par ce changement.
  concernes Json
  creeLe    DateTime @default(now()) @map("cree_le")
  creePar   String   @map("cree_par")
  police    Police   @relation(fields: [policeId], references: [id], onDelete: Restrict)

  @@unique([policeId, numero])
  @@map("adherents_versions")
}

/// Validation de l'émission des conditions particulières (CDC §4 « Oui (sous seuil) », §4.1, D22). Un profil dont le
/// droit « Émettre un contrat » est « Oui (sous seuil) » ne peut pas émettre un contrat dont le TTC dépasse le seuil du
/// produit : sa demande est enregistrée ici (A_VALIDER) ; un profil « Oui » qui n'est pas le demandeur l'émet, et la
/// demande passe à VALIDEE. Une seule demande ouverte par police (index partiel, voir la migration).
model ValidationContrat {
  id                    Int       @id @default(autoincrement())
  policeId              Int       @map("police_id")
  /// TTC du contrat et seuil du produit au moment de la demande.
  ttc                   Decimal   @db.Decimal(18, 2)
  seuil                 Decimal   @db.Decimal(18, 6)
  /// A_VALIDER, puis VALIDEE.
  statut                String
  demandeParId          Int       @map("demande_par_id")
  demandeParIdentifiant String    @map("demande_par_identifiant")
  demandeLe             DateTime  @default(now()) @map("demande_le")
  valideParId           Int?      @map("valide_par_id")
  valideParIdentifiant  String?   @map("valide_par_identifiant")
  valideLe              DateTime? @map("valide_le")
  police                Police    @relation(fields: [policeId], references: [id], onDelete: Restrict)

  @@index([policeId])
  @@map("validations_contrat")
}

/// Modèle Word de la bibliothèque (CDC §6.1). Le type et le code ne changent jamais ; le contenu,
/// lui, vit dans ses versions. Jamais supprimé (déclencheur PostgreSQL, voir la migration).
model Modele {
  id            Int             @id @default(autoincrement())
  /// CP, COTATION, FACTURE, AVOIR, RECU, AVIS_ECHEANCE, RELANCE, ANNEXE, SOUS_MODELE, CG, CS
  /// (src/domaine/documents/modeles.ts).
  type          String
  code          String          @unique
  libelle       String
  /// Produit propre au modèle (CP, cotation…), ou null : modèle commun.
  produitId     Int?            @map("produit_id")
  /// RELANCE : niveau 1, 2, 3…
  niveauRelance Int?            @map("niveau_relance")
  /// ANNEXE : liste reprise en entier (assures, beneficiaires, formules, echeances).
  listeAnnexe   String?         @map("liste_annexe")
  /// SOUS_MODELE : bloc("nom", clé).
  blocNom       String?         @map("bloc_nom")
  blocCle       String?         @map("bloc_cle")
  creeLe        DateTime        @default(now()) @map("cree_le")
  creePar       String          @map("cree_par")
  produit       Produit?        @relation(fields: [produitId], references: [id], onDelete: Restrict)
  versions      ModeleVersion[]

  @@index([type])
  @@map("modeles")
}

/// Version d'un modèle (CDC §6.6) : le fichier Word déposé, JAMAIS écrasé ni supprimé. Une version
/// publiée ne change plus du tout (déclencheur PostgreSQL) : un document émis se régénère avec la
/// version de son époque (T10).
model ModeleVersion {
  id                  Int                 @id @default(autoincrement())
  modeleId            Int                 @map("modele_id")
  /// 1, 2, 3… attribué au dépôt.
  numero              Int
  /// BROUILLON, SOUMIS ou PUBLIE (« archivé » se déduit des dates, voir domaine/documents/modeles.ts).
  statut              String
  /// Le .docx déposé, tel quel.
  fichier             Bytes
  nomFichier          String              @map("nom_fichier")
  taille              Int
  /// SHA-256 du fichier, en hexadécimal.
  empreinte           String
  commentaire         String
  /// Utilisée pour les nouvelles générations à partir de cette date (fixée à la publication).
  dateEffet           DateTime            @map("date_effet") @db.Date
  /// Résultat des contrôles au dépôt : avertissements, polices, données lues.
  analyse             Json
  auteurId            Int                 @map("auteur_id")
  auteurIdentifiant   String              @map("auteur_identifiant")
  deposeLe            DateTime            @default(now()) @map("depose_le")
  soumisLe            DateTime?           @map("soumis_le")
  /// Renvoi en brouillon par le valideur : motif.
  motifRenvoi         String?             @map("motif_renvoi")
  valideurId          Int?                @map("valideur_id")
  valideurIdentifiant String?             @map("valideur_identifiant")
  publieLe            DateTime?           @map("publie_le")
  /// CG et CS : visa et date du document (produit.cg_visa, produit.cg_date…).
  visa                String?
  dateDocument        DateTime?           @map("date_document") @db.Date
  /// CG et CS : PDF produit UNE fois, à la publication, et jamais reconverti.
  pdf                 Bytes?
  pdfEmpreinte        String?             @map("pdf_empreinte")
  modele              Modele              @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  documents           DocumentEmis[]
  aProduire           DocumentAProduire[]

  @@unique([modeleId, numero])
  @@index([statut])
  @@map("modele_versions")
}

/// Document émis (CDC §14) : un PDF stocké en AJOUT SEUL sur le volume persistant (D11). Une
/// réédition est une nouvelle ligne (version + 1) liée à la première, avec son propre fichier et son
/// propre jeton. Seule l'annulation par un avoir peut être ajoutée ensuite (déclencheur PostgreSQL).
model DocumentEmis {
  id                 Int                @id @default(autoincrement())
  /// COTATION, CP, FACTURE, AVOIR, RECU… (types de modèles, domaine/documents/modeles.ts).
  type               String
  /// Numéro du document (COT-2026-10-0001, POL-2026-000001…), commun à toutes ses versions.
  numero             String
  /// 1 = émission ; 2, 3… = rééditions.
  version            Int
  /// Première émission du document (null pour elle-même).
  origineId          Int?               @map("origine_id")
  /// Jeton du QR code (256 bits aléatoires, base64url) : jamais l'identifiant ni le numéro.
  jeton              String             @unique
  /// Chemin relatif dans le stockage (volume persistant).
  chemin             String             @unique
  /// SHA-256 du PDF final.
  empreinte          String
  taille             Int
  produitCode        String             @map("produit_code")
  policeNumero       String?            @map("police_numero")
  /// Pour la recherche (écran « Documents émis ») ; le public ne voit que la version masquée.
  souscripteurNom    String             @map("souscripteur_nom")
  souscripteurMasque String             @map("souscripteur_masque")
  cotationId         Int?               @map("cotation_id")
  policeId           Int?               @map("police_id")
  /// Certificat d'adhésion : numéro d'ordre de l'adhérent dans la police mère.
  adherentOrdre      Int?               @map("adherent_ordre")
  dateEmission       DateTime           @map("date_emission") @db.Date
  /// Cotation : fin de validité (statut « Expirée » sur la page de vérification).
  dateValidite       DateTime?          @map("date_validite") @db.Date
  /// Régénération à l'identique (T10) : version exacte du modèle, versions des annexes, sous-modèles,
  /// CS et CG, date des paramètres du produit, et données fusionnées.
  modeleVersionId    Int                @map("modele_version_id")
  versionsAssociees  Json               @map("versions_associees")
  parametresDate     DateTime           @map("parametres_date") @db.Date
  donnees            Json
  filigrane          String?
  emisLe             DateTime           @default(now()) @map("emis_le")
  emisPar            String             @map("emis_par")
  /// Annulation par un avoir (T12) : renseignée une seule fois, jamais effacée.
  annuleParNumero    String?            @map("annule_par_numero")
  annuleLe           DateTime?          @map("annule_le")
  modeleVersion      ModeleVersion      @relation(fields: [modeleVersionId], references: [id], onDelete: Restrict)
  /// Facture, avoir ou reçu : la production en attente dont il est issu.
  production         DocumentAProduire?
  /// Ligne d'import en masse qui l'a produit (certificat d'adhésion, session 5a).
  ligneImport        LigneImport?
  /// Écriture différée (T14) : fichier pas encore écrit dans le stockage.
  ecritureDifferee   EcritureDifferee?

  @@unique([numero, version])
  @@index([type])
  @@index([policeNumero])
  @@index([souscripteurNom])
  @@index([dateEmission])
  @@map("documents_emis")
}

/// Facture ou avoir (CDC §11, session 4b, D23). Un brouillon n'a pas de numéro ; le numéro (FAC-… ou AV-…) est attribué
/// à l'émission, dans la transaction qui l'enregistre (compteur verrouillé, sans trou). Une facture émise ne se modifie
/// ni ne se supprime (déclencheur PostgreSQL) : seule son annulation par un avoir s'ajoute, une fois.
model Facture {
  id               Int                 @id @default(autoincrement())
  /// AFFAIRE_NOUVELLE, RENOUVELLEMENT, AVENANT ou AVOIR (CDC §11.3).
  type             String
  /// BROUILLON, A_VALIDER, EMISE, ANNULEE (par un avoir) ou ABANDONNEE (brouillon abandonné, session 6.2b, H87).
  statut           String
  numero           String?             @unique
  policeId         Int                 @map("police_id")
  produitId        Int                 @map("produit_id")
  /// Version du produit dont vient le tarif (et le seuil de validation).
  versionDateEffet DateTime            @map("version_date_effet") @db.Date
  /// Avoir : la facture qu'il annule (doc.facture_origine).
  factureOrigineId Int?                @map("facture_origine_id")
  /// Nouvelle facture qui remplace une facture annulée par un avoir (T4).
  remplaceId       Int?                @map("remplace_id")
  /// Avenant d'incorporation : numéro de la version de la liste des adhérents facturée.
  adherentsVersion Int?                @map("adherents_version")
  dateEffet        DateTime            @map("date_effet") @db.Date
  dateEcheance     DateTime            @map("date_echeance") @db.Date
  /// Contenu figé (montants du moteur en texte, souscripteur, assurés, échéancier, « Envoyé à »), voir domaine/facturation.
  contenu          Json
  /// TTC de la facture ; négatif pour un avoir.
  ttc              Decimal             @db.Decimal(18, 2)
  /// Avoir : motif obligatoire.
  motif            String?
  creeParId        Int                 @map("cree_par_id")
  creePar          String              @map("cree_par")
  creeLe           DateTime            @default(now()) @map("cree_le")
  /// « Oui (sous seuil) » au-dessus du seuil du produit : demande de validation (CDC §4.1).
  demandeParId     Int?                @map("demande_par_id")
  demandePar       String?             @map("demande_par")
  demandeLe        DateTime?           @map("demande_le")
  emiseParId       Int?                @map("emise_par_id")
  emisePar         String?             @map("emise_par")
  emiseLe          DateTime?           @map("emise_le")
  dateEmission     DateTime?           @map("date_emission") @db.Date
  /// Annulation par un avoir : renseignée une seule fois.
  annuleeParId     Int?                @map("annulee_par_id")
  annuleeLe        DateTime?           @map("annulee_le")
  /// Brouillon abandonné : qui, quand, pourquoi (motif obligatoire) ; définitif, sans numéro.
  abandonneParId   Int?                @map("abandonne_par_id")
  abandonnePar     String?             @map("abandonne_par")
  abandonneLe      DateTime?           @map("abandonne_le")
  motifAbandon     String?             @map("motif_abandon")
  police           Police              @relation(fields: [policeId], references: [id], onDelete: Restrict)
  produit          Produit             @relation(fields: [produitId], references: [id], onDelete: Restrict)
  factureOrigine   Facture?            @relation("Avoir", fields: [factureOrigineId], references: [id], onDelete: Restrict)
  avoirs           Facture[]           @relation("Avoir")
  remplace         Facture?            @relation("Remplacement", fields: [remplaceId], references: [id], onDelete: Restrict)
  remplacantes     Facture[]           @relation("Remplacement")
  annuleePar       Facture?            @relation("Annulation", fields: [annuleeParId], references: [id], onDelete: Restrict)
  annulees         Facture[]           @relation("Annulation")
  paiements        Paiement[]
  aProduire        DocumentAProduire[]
  /// Facture annulée : ses sommes encaissées, reportées en avance sur la police (H47, session 6.0).
  reports          MouvementAvance[]   @relation("ReportAnnulation")
  /// Imputations d'avance reçues par cette facture (session 6.0).
  imputations      MouvementAvance[]   @relation("Imputation")

  elementsLots ElementLotEcheances[]

  @@index([policeId])
  @@index([statut])
  @@map("factures")
}

/// Paiement d'une facture (CDC §12) : ajout seul. Chaque paiement a son reçu (REC-…, numéro attribué dans la même
/// transaction) et entraîne une réédition de la facture (même numéro, version + 1, restant dû à jour).
model Paiement {
  id               Int                 @id @default(autoincrement())
  factureId        Int                 @map("facture_id")
  numeroRecu       String              @unique @map("numero_recu")
  date             DateTime            @db.Date
  montant          Decimal             @db.Decimal(18, 2)
  /// Trop-perçu (H33, session 6.0) : part du montant au-delà du restant dû, versée en avance sur la police.
  excedent         Decimal             @default(0) @db.Decimal(18, 2)
  /// ESPECES, CHEQUE, VIREMENT ou MOBILE_MONEY.
  canal            String
  reference        String
  payeur           String
  creeParId        Int                 @map("cree_par_id")
  creePar          String              @map("cree_par")
  creeLe           DateTime            @default(now()) @map("cree_le")
  facture          Facture             @relation(fields: [factureId], references: [id], onDelete: Restrict)
  aProduire        DocumentAProduire[]
  mouvementsAvance MouvementAvance[]

  @@index([factureId])
  @@map("paiements")
}

/// Mouvement de l'avance d'une police (session 6.0, H33, H47), en ajout seul. Crédits : EXCEDENT (trop-perçu d'un paiement),
/// REPORT (somme encaissée sur une facture annulée par un avoir). Débits : IMPUTATION (sur une facture émise de la même
/// police), RESTITUTION (remboursement). Le solde n'est jamais négatif : la base le contrôle (déclencheur).
model MouvementAvance {
  id                  Int               @id @default(autoincrement())
  policeId            Int               @map("police_id")
  /// EXCEDENT, REPORT, IMPUTATION ou RESTITUTION.
  type                String
  montant             Decimal           @db.Decimal(18, 2)
  date                DateTime          @db.Date
  /// Paiement d'origine : celui qui a laissé l'excédent, ou celui dont la somme est reportée puis imputée.
  paiementId          Int?              @map("paiement_id")
  /// REPORT : facture annulée dont la somme vient.
  factureAnnuleeId    Int?              @map("facture_annulee_id")
  /// IMPUTATION : facture réglée par l'avance.
  factureId           Int?              @map("facture_id")
  /// IMPUTATION d'un report sur la facture de remplacement : le report imputé.
  reportId            Int?              @map("report_id")
  /// RESTITUTION : canal et référence du remboursement.
  canal               String?
  reference           String?
  creeParId           Int               @map("cree_par_id")
  creePar             String            @map("cree_par")
  creeLe              DateTime          @default(now()) @map("cree_le")
  police              Police            @relation(fields: [policeId], references: [id], onDelete: Restrict)
  paiement            Paiement?         @relation(fields: [paiementId], references: [id], onDelete: Restrict)
  factureAnnulee      Facture?          @relation("ReportAnnulation", fields: [factureAnnuleeId], references: [id], onDelete: Restrict)
  facture             Facture?          @relation("Imputation", fields: [factureId], references: [id], onDelete: Restrict)
  report              MouvementAvance?  @relation("ReportImpute", fields: [reportId], references: [id], onDelete: Restrict)
  imputationsDuReport MouvementAvance[] @relation("ReportImpute")

  @@index([policeId])
  @@index([factureId])
  @@index([factureAnnuleeId])
  @@map("mouvements_avance")
}

/// Document à produire (session 4b, CDC §11.4) : facture, avoir ou reçu dont le numéro est déjà attribué. Tout est figé
/// dans la transaction de l'émission (données, jeton du QR code, versions des modèles) ; le PDF est produit APRÈS la
/// validation de la transaction. S'il échoue, la ligne reste « EN_ATTENTE » et la production se relance à l'identique.
/// Une fois produit, le document émis (documents_emis) porte le même numéro, la même version et le même jeton.
model DocumentAProduire {
  id                 Int           @id @default(autoincrement())
  type               String
  numero             String
  version            Int
  jeton              String        @unique
  factureId          Int?          @map("facture_id")
  paiementId         Int?          @map("paiement_id")
  produitCode        String        @map("produit_code")
  policeNumero       String?       @map("police_numero")
  policeId           Int?          @map("police_id")
  cotationId         Int?          @map("cotation_id")
  souscripteurNom    String        @map("souscripteur_nom")
  souscripteurMasque String        @map("souscripteur_masque")
  dateEmission       DateTime      @map("date_emission") @db.Date
  parametresDate     DateTime      @map("parametres_date") @db.Date
  modeleVersionId    Int           @map("modele_version_id")
  versionsAssociees  Json          @map("versions_associees")
  donnees            Json
  emisPar            String        @map("emis_par")
  creeLe             DateTime      @default(now()) @map("cree_le")
  /// EN_ATTENTE (« PDF en attente ») ou PRODUIT.
  statut             String        @default("EN_ATTENTE")
  tentatives         Int           @default(0)
  derniereErreur     String?       @map("derniere_erreur")
  documentId         Int?          @unique @map("document_id")
  produitLe          DateTime?     @map("produit_le")
  /// Avis d'échéance ou relance (session 5b) : n° de l'échéance appelée de la facture.
  echeanceNumero     Int?          @map("echeance_numero")
  /// Relance : niveau (1 à 9). Un seul avis par échéance, une relance par (échéance, niveau) : index uniques partiels.
  niveauRelance      Int?          @map("niveau_relance")
  facture            Facture?      @relation(fields: [factureId], references: [id], onDelete: Restrict)
  paiement           Paiement?     @relation(fields: [paiementId], references: [id], onDelete: Restrict)
  modeleVersion      ModeleVersion @relation(fields: [modeleVersionId], references: [id], onDelete: Restrict)
  document           DocumentEmis? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([numero, version])
  @@index([statut])
  @@index([factureId])
  @@map("documents_a_produire")
}

/// Import en masse des adhérents d'une police mère (CDC §13, session 5a, D24). CONTROLE : fichier lu et contrôlé, rien
/// n'est encore créé ; EN_COURS : confirmé, adhérents incorporés (UNE version de la liste), certificats produits par la
/// file de tâches ; TERMINE : archive ZIP et récapitulatif ; ABANDONNE : contrôle abandonné. L'avancement se lit dans
/// les lignes, jamais dans un compteur à part.
model LotImport {
  id               Int           @id @default(autoincrement())
  policeId         Int           @map("police_id")
  produitCode      String        @map("produit_code")
  /// Date d'effet de l'incorporation (date d'adhésion des adhérents importés).
  dateEffet        DateTime      @map("date_effet") @db.Date
  fichierNom       String        @map("fichier_nom")
  statut           String
  total            Int
  valides          Int
  erreurs          Int
  /// Version de la liste des adhérents créée par la confirmation.
  versionAdherents Int?          @map("version_adherents")
  zipChemin        String?       @map("zip_chemin")
  zipEmpreinte     String?       @map("zip_empreinte")
  zipTaille        Int?          @map("zip_taille")
  creeParId        Int           @map("cree_par_id")
  creePar          String        @map("cree_par")
  creeLe           DateTime      @default(now()) @map("cree_le")
  confirmeParId    Int?          @map("confirme_par_id")
  confirmePar      String?       @map("confirme_par")
  debut            DateTime?
  fin              DateTime?
  derniereErreur   String?       @map("derniere_erreur")
  police           Police        @relation(fields: [policeId], references: [id], onDelete: Restrict)
  lignes           LigneImport[]
  taches           TachePolice[]

  @@index([policeId])
  @@map("lots_import")
}

/// Ligne d'un import : données lues (noms du dictionnaire), erreurs de contrôle ([{ colonne, valeur, message }]).
/// VALIDE → PRODUIT (certificat émis) ou ECHEC (génération en échec, rejouée à la relance) ; ERREUR : jamais traitée.
model LigneImport {
  id             Int           @id @default(autoincrement())
  lotId          Int           @map("lot_id")
  numeroLigne    Int           @map("numero_ligne")
  donnees        Json
  erreurs        Json
  statut         String
  adherentOrdre  Int?          @map("adherent_ordre")
  documentId     Int?          @unique @map("document_id")
  tentatives     Int           @default(0)
  derniereErreur String?       @map("derniere_erreur")
  lot            LotImport     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  document       DocumentEmis? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([lotId, numeroLigne])
  @@index([lotId, statut])
  @@map("lots_import_lignes")
}

/// Écriture différée (T14, D11) : le document est ÉMIS (documents_emis), mais son fichier n'a pas pu être écrit dans
/// le stockage. Le PDF est gardé ici (toujours téléchargeable) ; la file de tâches reprend l'écriture avec des délais
/// croissants, et la ligne disparaît quand le fichier est écrit. Alerte : journal d'audit et bandeau d'administration.
model EcritureDifferee {
  id             Int          @id @default(autoincrement())
  documentId     Int          @unique @map("document_id")
  chemin         String
  empreinte      String
  contenu        Bytes
  tentatives     Int          @default(1)
  derniereErreur String       @map("derniere_erreur")
  creeLe         DateTime     @default(now()) @map("cree_le")
  dernierEssai   DateTime     @default(now()) @map("dernier_essai")
  document       DocumentEmis @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@map("ecritures_differees")
}

/// Tâche visible sur une police (H64) : « Nouvelle version des CP à émettre » ou « Facture d'avenant à émettre », créée par
/// un import confirmé. Ouverte tant que la pièce n'est pas émise : l'état est lu dans les documents et les factures.
model TachePolice {
  id               Int        @id @default(autoincrement())
  policeId         Int        @map("police_id")
  /// CP_A_EMETTRE | FACTURE_AVENANT_A_EMETTRE
  type             String
  lotId            Int?       @map("lot_id")
  /// Version de la liste des adhérents à reprendre (CP) ou à facturer (avenant).
  versionAdherents Int        @map("version_adherents")
  creePar          String     @map("cree_par")
  creeLe           DateTime   @default(now()) @map("cree_le")
  /// H66 (session 6.0) : AUTOMATIQUE (pièce émise) ou MANUELLE (motif obligatoire) ; null tant qu'elle est ouverte.
  fermeture        String?
  fermeeLe         DateTime?  @map("fermee_le")
  fermeePar        String?    @map("fermee_par")
  motifFermeture   String?    @map("motif_fermeture")
  police           Police     @relation(fields: [policeId], references: [id], onDelete: Restrict)
  lot              LotImport? @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([policeId, type, versionAdherents], map: "taches_police_unique")
  @@index([lotId])
  @@map("taches_police")
}

/// Lot de génération d'avis d'échéance et de relances (CDC §12, session 5b) : sélection dans la liste du jour, traitée par
/// la file de tâches. EN_COURS puis TERMINE ; l'avancement se lit dans les éléments.
model LotEcheances {
  id        Int                   @id @default(autoincrement())
  statut    String
  /// Jour de la liste d'où vient la sélection.
  dateListe DateTime              @map("date_liste") @db.Date
  creeParId Int                   @map("cree_par_id")
  creePar   String                @map("cree_par")
  creeLe    DateTime              @default(now()) @map("cree_le")
  debut     DateTime?
  fin       DateTime?
  elements  ElementLotEcheances[]

  @@map("lots_echeances")
}

/// Élément d'un lot : un avis (AVIS_ECHEANCE) ou une relance (RELANCE, avec son niveau) pour une échéance d'une facture.
/// A_FAIRE, puis PRODUIT, DEJA_PRODUIT, SANS_OBJET (payée, facture annulée, pas encore due) ou ECHEC.
model ElementLotEcheances {
  id             Int          @id @default(autoincrement())
  lotId          Int          @map("lot_id")
  type           String
  factureId      Int          @map("facture_id")
  echeanceNumero Int          @map("echeance_numero")
  niveauRelance  Int?         @map("niveau_relance")
  statut         String       @default("A_FAIRE")
  numero         String?
  message        String?
  lot            LotEcheances @relation(fields: [lotId], references: [id], onDelete: Restrict)
  facture        Facture      @relation(fields: [factureId], references: [id], onDelete: Restrict)

  @@index([lotId])
  @@map("lots_echeances_elements")
}
