// Schéma de la base PostgreSQL de SIM Documents.
// Documentation : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Client généré dans src/generated/ (ignoré par Git), recréé par `npx prisma generate`.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 : l'adresse de la base se règle dans prisma7.config.ts, plus ici.
}

/// Paramètre du cahier des charges, historisé : changer une valeur, c'est ajouter
/// une ligne avec une nouvelle date d'effet, jamais modifier une ligne existante.
model Parametre {
  id        Int      @id @default(autoincrement())
  /// Identifiant du paramètre.
  cle       String
  /// Valeur en texte, convertie par le code qui la lit (un montant en Decimal, jamais en flottant).
  valeur    String
  /// Date à partir de laquelle la valeur s'applique.
  dateEffet DateTime @map("date_effet") @db.Date
  creeLe    DateTime @default(now()) @map("cree_le")
  /// Auteur de la saisie (identifiant de l'utilisateur, en attendant l'authentification).
  creePar   String   @map("cree_par")

  @@unique([cle, dateEffet])
  @@map("parametres")
}

/// Profil du CDC §4 (Commercial, Technique...). Les codes sont définis dans src/domaine/droits.ts.
model Profil {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  libelle      String
  droits       ProfilDroit[]
  utilisateurs Utilisateur[]

  @@map("profils")
}

/// Droit d'un profil sur une action : modifiable par l'Admin système (« droits paramétrables »).
model ProfilDroit {
  profilId Int    @map("profil_id")
  /// Code d'action (CREER_COTATION...), voir src/domaine/droits.ts.
  action   String
  /// Code de niveau (AUCUN, LECTURE, DEMANDE, PROPOSITION, OUI_SOUS_SEUIL, OUI, VALIDE).
  niveau   String
  profil   Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)

  @@id([profilId, action])
  @@map("profils_droits")
}

/// Compte de connexion au back-office. Jamais supprimé : désactivé (actif = false), pour garder l'historique.
model Utilisateur {
  id                    Int            @id @default(autoincrement())
  /// En minuscules (normalisé avant l'enregistrement).
  identifiant           String         @unique
  nom                   String
  /// Empreinte scrypt du mot de passe (format « scrypt$N$r$p$sel$empreinte »), jamais le mot de passe.
  motDePasseHash        String         @map("mot_de_passe_hash")
  profilId              Int            @map("profil_id")
  actif                 Boolean        @default(true)
  /// Vrai après une création ou une réinitialisation par l'administrateur : changement obligatoire.
  doitChangerMotDePasse Boolean        @default(false) @map("doit_changer_mot_de_passe")
  echecsConsecutifs     Int            @default(0) @map("echecs_consecutifs")
  verrouilleJusqua      DateTime?      @map("verrouille_jusqua")
  derniereConnexionLe   DateTime?      @map("derniere_connexion_le")
  creeLe                DateTime       @default(now()) @map("cree_le")
  modifieLe             DateTime       @updatedAt @map("modifie_le")
  profil                Profil         @relation(fields: [profilId], references: [id], onDelete: Restrict)
  evenements            JournalAudit[]

  @@map("utilisateurs")
}

/// Journal d'audit (CDC §15.4) : ajout seul. Un déclencheur PostgreSQL refuse UPDATE, DELETE et
/// TRUNCATE (voir la migration). Écrit par une seule fonction : src/serveur/audit.ts.
model JournalAudit {
  id                     BigInt       @id @default(autoincrement())
  horodatage             DateTime     @default(now())
  utilisateurId          Int?         @map("utilisateur_id")
  /// Copie de l'identifiant au moment de l'action : lisible même si le compte évolue.
  utilisateurIdentifiant String?      @map("utilisateur_identifiant")
  action                 String
  objetType              String?      @map("objet_type")
  objetId                String?      @map("objet_id")
  avant                  Json?
  apres                  Json?
  adresseIp              String?      @map("adresse_ip")
  utilisateur            Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([horodatage])
  @@index([action])
  @@index([utilisateurId])
  @@map("journal_audit")
}

/// Branche fiscale (D21) : liste paramétrable, clé des taux de taxe et des produits. Le code ne change
/// jamais ; le libellé et l'état actif se modifient (modifications journalisées). Une branche désactivée
/// garde ses taux et ses produits, mais n'en reçoit plus de nouveaux.
model Branche {
  code     String    @id
  libelle  String
  actif    Boolean   @default(true)
  creeLe   DateTime  @default(now()) @map("cree_le")
  creePar  String    @map("cree_par")
  taxes    Taxe[]
  produits Produit[]

  @@map("branches")
}

/// Taux de taxe (CDC §8.3, D18), historisé : clé (branche, type de contrat, date d'effet). Une ligne en
/// vigueur ne se modifie pas, sauf sa clôture (date de fin posée une fois). Pour une même clé, deux
/// périodes ne se chevauchent jamais : contrainte d'exclusion PostgreSQL (voir la migration).
model Taxe {
  id             Int       @id @default(autoincrement())
  branche        String
  brancheFiscale Branche   @relation(fields: [branche], references: [code], onDelete: Restrict, onUpdate: Restrict)
  /// INDIVIDUEL, FAMILLE, GROUPE, GROUPE_OUVERT, ou null : tous types de contrat.
  typeContrat    String?   @map("type_contrat")
  /// En pourcentage : 1.5 pour 1,5 %. Null seulement pour une ligne à taux mixte.
  tauxPourcent   Decimal?  @map("taux_pourcent") @db.Decimal(9, 6)
  /// Plusieurs taux dans un même contrat (incendie / dommages aux biens) : calcul refusé.
  tauxMixte      Boolean   @default(false) @map("taux_mixte")
  commentaire    String?
  /// NETTE_ACCESSOIRES (défaut du CDC) ou NETTE.
  assiette       String    @default("NETTE_ACCESSOIRES")
  dateEffet      DateTime  @map("date_effet") @db.Date
  dateFin        DateTime? @map("date_fin") @db.Date
  creeLe         DateTime  @default(now()) @map("cree_le")
  creePar        String    @map("cree_par")

  @@index([branche])
  @@map("taxes")
}

/// Produit d'assurance (CDC §2.3, §7). Aucun produit n'est codé en dur : tout vient d'ici.
model Produit {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  libelle        String
  gamme          String
  /// Branche fiscale : clé de la table des taxes (liste paramétrable, table branches).
  branche        String
  brancheFiscale Branche          @relation(fields: [branche], references: [code], onDelete: Restrict, onUpdate: Restrict)
  actif          Boolean          @default(true)
  creeLe         DateTime         @default(now()) @map("cree_le")
  creePar        String           @map("cree_par")
  versions       ProduitVersion[]
  cotations      Cotation[]
  modeles        Modele[]

  @@map("produits")
}

/// Fiche de paramétrage d'un produit à partir d'une date d'effet. HISTORISÉE : on ajoute une version,
/// on ne modifie jamais une version en vigueur (déclencheur PostgreSQL, voir la migration).
model ProduitVersion {
  id                          Int       @id @default(autoincrement())
  produitId                   Int       @map("produit_id")
  dateEffet                   DateTime  @map("date_effet") @db.Date
  arrondiPrecision            Int       @map("arrondi_precision")
  arrondiSens                 String    @map("arrondi_sens")
  arrondiNiveau               String    @map("arrondi_niveau")
  arrondiComposante           String    @map("arrondi_composante")
  prorataActif                Boolean   @map("prorata_actif")
  primeMinimale               Decimal?  @map("prime_minimale") @db.Decimal(18, 6)
  fractionnementTranchesMax   Int       @default(1) @map("fractionnement_tranches_max")
  /// Tableau JSON de pourcentages en texte (["40","30","30"]), ou null : tranches égales.
  fractionnementRepartition   Json?     @map("fractionnement_repartition")
  fractionnementDecalagesMois Json?     @map("fractionnement_decalages_mois")
  fraisFractionnement         Decimal   @default(0) @map("frais_fractionnement") @db.Decimal(18, 6)
  validiteMois                Int       @default(3) @map("validite_mois")
  formulesMax                 Int       @default(3) @map("formules_max")
  seuilValidationTtc          Decimal?  @map("seuil_validation_ttc") @db.Decimal(18, 6)
  /// Références contractuelles (CDC §7) : code du modèle de CG (et de CS) joint au contrat, et visa
  /// cité dans les CP. À l'assemblage, ce visa doit être celui des CG jointes (contrôle bloquant, §6.8).
  cgModeleCode                String?   @map("cg_modele_code")
  cgVisa                      String?   @map("cg_visa")
  csModeleCode                String?   @map("cs_modele_code")
  csVisa                      String?   @map("cs_visa")
  creeLe                      DateTime  @default(now()) @map("cree_le")
  creePar                     String    @map("cree_par")
  produit                     Produit   @relation(fields: [produitId], references: [id], onDelete: Restrict)
  formules                    Formule[]

  @@unique([produitId, dateEffet])
  @@map("produit_versions")
}

/// Formule d'une version de produit (Solo, Famille, taux 70 %...). Prime unitaire avec décimales (CDC §8.5).
model Formule {
  id               Int            @id @default(autoincrement())
  produitVersionId Int            @map("produit_version_id")
  code             String
  libelle          String
  tauxCouverture   Decimal?       @map("taux_couverture") @db.Decimal(6, 3)
  primeUnitaire    Decimal        @map("prime_unitaire") @db.Decimal(18, 6)
  /// AUCUN, FIXE, PAR_TETE, PAR_FAMILLE ou POURCENT.
  accessoireMode   String         @map("accessoire_mode")
  accessoireValeur Decimal        @default(0) @map("accessoire_valeur") @db.Decimal(18, 6)
  version          ProduitVersion @relation(fields: [produitVersionId], references: [id], onDelete: Restrict)

  @@unique([produitVersionId, code])
  @@map("formules")
}

/// Client enregistré (souscripteur connu). Un prospect, lui, se saisit librement sur la cotation (CDC §9.1).
model Client {
  id            Int        @id @default(autoincrement())
  /// PHYSIQUE ou MORALE (dictionnaire souscripteur.type).
  type          String
  nom           String
  prenoms       String     @default("")
  raisonSociale String     @default("") @map("raison_sociale")
  telephone     String     @default("")
  email         String     @default("")
  adresse       String     @default("")
  creeLe        DateTime   @default(now()) @map("cree_le")
  creePar       String     @map("cree_par")
  cotations     Cotation[]

  @@map("clients")
}

/// Compteurs de numérotation (CDC §11.4) : un par type de document et par année (« COT-2026 »).
/// Incrémenté dans la transaction de l'émission : annulée, elle ne laisse aucun trou.
model Sequence {
  cle    String @id
  valeur Int

  @@map("sequences")
}

/// Motifs de refus d'une cotation : liste paramétrable (CDC §9.3).
model MotifRefus {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)

  @@map("motifs_refus")
}

/// Cotation (CDC §9). Brouillon et « À valider » se modifient ; dès « Émise », les données sont FIGÉES
/// (déclencheur PostgreSQL) : seuls le statut et l'issue (acceptation, refus) évoluent.
model Cotation {
  id                Int       @id @default(autoincrement())
  /// COT-AAAA-MM-NNNN : attribué à l'émission seulement (un brouillon n'a pas de numéro).
  numero            String?   @unique
  /// BROUILLON, A_VALIDER, EMISE, ACCEPTEE, REFUSEE ou EXPIREE.
  statut            String
  produitId         Int       @map("produit_id")
  /// Date d'effet de la version du produit utilisée pour le calcul.
  versionDateEffet  DateTime  @map("version_date_effet") @db.Date
  clientId          Int?      @map("client_id")
  /// Dictionnaire souscripteur.* (copie : une cotation émise ne bouge pas si le client est modifié).
  souscripteur      Json
  dateEffet         DateTime  @map("date_effet") @db.Date
  dateEcheance      DateTime  @map("date_echeance") @db.Date
  nombreTranches    Int       @default(1) @map("nombre_tranches")
  /// [{ code, effectif, primeTarif, primeForcee|null }]
  lignes            Json
  motifForcage      String?   @map("motif_forcage")
  assures           Json      @default("[]")
  risque            Json      @default("{}")
  /// INDIVIDUEL, FAMILLE, GROUPE ou GROUPE_OUVERT (police.type_contrat) : choisit le taux de taxe (D18).
  /// Null pour une cotation créée avant la session 4.0.
  typeContrat       String?   @map("type_contrat")
  /// Entrée complète du moteur de calcul (montants en texte) : permet de recalculer à l'identique.
  donneesCalcul     Json?     @map("donnees_calcul")
  /// Montants arrondis par formule et en total (texte).
  resultat          Json?
  ttcTotal          Decimal?  @map("ttc_total") @db.Decimal(18, 2)
  echeancier        Json?
  /// ["PRIME_FORCEE", "SEUIL_DEPASSE"] : pourquoi la validation est exigée.
  raisonsValidation Json      @default("[]") @map("raisons_validation")
  auteurId          Int       @map("auteur_id")
  auteurIdentifiant String    @map("auteur_identifiant")
  /// Utilisateurs qui ont créé ou modifié le brouillon (H9) : aucun d'eux ne peut valider la cotation.
  contributeurs     Int[]     @default([])
  valideParId       Int?      @map("valide_par_id")
  valideLe          DateTime? @map("valide_le")
  dateEtablissement DateTime? @map("date_etablissement") @db.Date
  dateValidite      DateTime? @map("date_validite") @db.Date
  emiseLe           DateTime? @map("emise_le")
  formulesRetenues  Json?     @map("formules_retenues")
  accepteeLe        DateTime? @map("acceptee_le")
  motifRefusCode    String?   @map("motif_refus_code")
  refusCommentaire  String?   @map("refus_commentaire")
  creeLe            DateTime  @default(now()) @map("cree_le")
  modifieLe         DateTime  @updatedAt @map("modifie_le")
  produit           Produit   @relation(fields: [produitId], references: [id], onDelete: Restrict)
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  police            Police?

  @@index([statut])
  @@index([dateValidite])
  @@index([produitId])
  @@map("cotations")
}

/// Police créée à l'acceptation d'une cotation (CDC §9.4). Le numéro est attribué par SIM et SAISI
/// (H10, D18) : jamais généré par le module ; unique ; format contrôlé par un paramètre (H31).
model Police {
  id               Int      @id @default(autoincrement())
  numero           String   @unique
  /// INDIVIDUEL, FAMILLE, GROUPE ou GROUPE_OUVERT (police.type_contrat). Null avant la session 4.0.
  typeContrat      String?  @map("type_contrat")
  cotationId       Int      @unique @map("cotation_id")
  produitCode      String   @map("produit_code")
  souscripteur     Json
  assures          Json
  risque           Json
  formulesRetenues Json     @map("formules_retenues")
  donneesCalcul    Json     @map("donnees_calcul")
  resultat         Json
  ttcTotal         Decimal  @map("ttc_total") @db.Decimal(18, 2)
  echeancier       Json
  dateEffet        DateTime @map("date_effet") @db.Date
  dateEcheance     DateTime @map("date_echeance") @db.Date
  creeLe           DateTime @default(now()) @map("cree_le")
  creePar          String   @map("cree_par")
  cotation         Cotation @relation(fields: [cotationId], references: [id], onDelete: Restrict)

  @@map("polices")
}

/// Modèle Word de la bibliothèque (CDC §6.1). Le type et le code ne changent jamais ; le contenu,
/// lui, vit dans ses versions. Jamais supprimé (déclencheur PostgreSQL, voir la migration).
model Modele {
  id            Int             @id @default(autoincrement())
  /// CP, COTATION, FACTURE, AVOIR, RECU, AVIS_ECHEANCE, RELANCE, ANNEXE, SOUS_MODELE, CG, CS
  /// (src/domaine/documents/modeles.ts).
  type          String
  code          String          @unique
  libelle       String
  /// Produit propre au modèle (CP, cotation…), ou null : modèle commun.
  produitId     Int?            @map("produit_id")
  /// RELANCE : niveau 1, 2, 3…
  niveauRelance Int?            @map("niveau_relance")
  /// ANNEXE : liste reprise en entier (assures, beneficiaires, formules, echeances).
  listeAnnexe   String?         @map("liste_annexe")
  /// SOUS_MODELE : bloc("nom", clé).
  blocNom       String?         @map("bloc_nom")
  blocCle       String?         @map("bloc_cle")
  creeLe        DateTime        @default(now()) @map("cree_le")
  creePar       String          @map("cree_par")
  produit       Produit?        @relation(fields: [produitId], references: [id], onDelete: Restrict)
  versions      ModeleVersion[]

  @@index([type])
  @@map("modeles")
}

/// Version d'un modèle (CDC §6.6) : le fichier Word déposé, JAMAIS écrasé ni supprimé. Une version
/// publiée ne change plus du tout (déclencheur PostgreSQL) : un document émis se régénère avec la
/// version de son époque (T10).
model ModeleVersion {
  id                  Int            @id @default(autoincrement())
  modeleId            Int            @map("modele_id")
  /// 1, 2, 3… attribué au dépôt.
  numero              Int
  /// BROUILLON, SOUMIS ou PUBLIE (« archivé » se déduit des dates, voir domaine/documents/modeles.ts).
  statut              String
  /// Le .docx déposé, tel quel.
  fichier             Bytes
  nomFichier          String         @map("nom_fichier")
  taille              Int
  /// SHA-256 du fichier, en hexadécimal.
  empreinte           String
  commentaire         String
  /// Utilisée pour les nouvelles générations à partir de cette date (fixée à la publication).
  dateEffet           DateTime       @map("date_effet") @db.Date
  /// Résultat des contrôles au dépôt : avertissements, polices, données lues.
  analyse             Json
  auteurId            Int            @map("auteur_id")
  auteurIdentifiant   String         @map("auteur_identifiant")
  deposeLe            DateTime       @default(now()) @map("depose_le")
  soumisLe            DateTime?      @map("soumis_le")
  /// Renvoi en brouillon par le valideur : motif.
  motifRenvoi         String?        @map("motif_renvoi")
  valideurId          Int?           @map("valideur_id")
  valideurIdentifiant String?        @map("valideur_identifiant")
  publieLe            DateTime?      @map("publie_le")
  /// CG et CS : visa et date du document (produit.cg_visa, produit.cg_date…).
  visa                String?
  dateDocument        DateTime?      @map("date_document") @db.Date
  /// CG et CS : PDF produit UNE fois, à la publication, et jamais reconverti.
  pdf                 Bytes?
  pdfEmpreinte        String?        @map("pdf_empreinte")
  modele              Modele         @relation(fields: [modeleId], references: [id], onDelete: Restrict)
  documents           DocumentEmis[]

  @@unique([modeleId, numero])
  @@index([statut])
  @@map("modele_versions")
}

/// Document émis (CDC §14) : un PDF stocké en AJOUT SEUL sur le volume persistant (D11). Une
/// réédition est une nouvelle ligne (version + 1) liée à la première, avec son propre fichier et son
/// propre jeton. Seule l'annulation par un avoir peut être ajoutée ensuite (déclencheur PostgreSQL).
model DocumentEmis {
  id                 Int           @id @default(autoincrement())
  /// COTATION, CP, FACTURE, AVOIR, RECU… (types de modèles, domaine/documents/modeles.ts).
  type               String
  /// Numéro du document (COT-2026-10-0001, POL-2026-000001…), commun à toutes ses versions.
  numero             String
  /// 1 = émission ; 2, 3… = rééditions.
  version            Int
  /// Première émission du document (null pour elle-même).
  origineId          Int?          @map("origine_id")
  /// Jeton du QR code (256 bits aléatoires, base64url) : jamais l'identifiant ni le numéro.
  jeton              String        @unique
  /// Chemin relatif dans le stockage (volume persistant).
  chemin             String        @unique
  /// SHA-256 du PDF final.
  empreinte          String
  taille             Int
  produitCode        String        @map("produit_code")
  policeNumero       String?       @map("police_numero")
  /// Pour la recherche (écran « Documents émis ») ; le public ne voit que la version masquée.
  souscripteurNom    String        @map("souscripteur_nom")
  souscripteurMasque String        @map("souscripteur_masque")
  cotationId         Int?          @map("cotation_id")
  policeId           Int?          @map("police_id")
  dateEmission       DateTime      @map("date_emission") @db.Date
  /// Cotation : fin de validité (statut « Expirée » sur la page de vérification).
  dateValidite       DateTime?     @map("date_validite") @db.Date
  /// Régénération à l'identique (T10) : version exacte du modèle, versions des annexes, sous-modèles,
  /// CS et CG, date des paramètres du produit, et données fusionnées.
  modeleVersionId    Int           @map("modele_version_id")
  versionsAssociees  Json          @map("versions_associees")
  parametresDate     DateTime      @map("parametres_date") @db.Date
  donnees            Json
  filigrane          String?
  emisLe             DateTime      @default(now()) @map("emis_le")
  emisPar            String        @map("emis_par")
  /// Annulation par un avoir (T12) : renseignée une seule fois, jamais effacée.
  annuleParNumero    String?       @map("annule_par_numero")
  annuleLe           DateTime?     @map("annule_le")
  modeleVersion      ModeleVersion @relation(fields: [modeleVersionId], references: [id], onDelete: Restrict)

  @@unique([numero, version])
  @@index([type])
  @@index([policeNumero])
  @@index([souscripteurNom])
  @@index([dateEmission])
  @@map("documents_emis")
}
