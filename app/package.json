{
  "name": "sim-documents-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/completer-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "initialiser": "tsx --conditions=react-server scripts/initialiser.mts",
    "creer-admin": "tsx --conditions=react-server scripts/creer-admin.mts",
    "seed:dev": "tsx --conditions=react-server scripts/seed-dev.mts",
    "ranger:dev": "tsx --conditions=react-server scripts/ranger-fichiers-dev.mts",
    "travailleur": "tsx --conditions=react-server scripts/travailleur.mts",
    "test:integration:preparer": "node scripts/preparer-base-test.mjs",
    "test:integration": "npm run test:integration:preparer && vitest run --config vitest.integration.config.mts",
    "test:e2e": "npm run test:integration:preparer && vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.8",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "jszip": "3.10.2",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
