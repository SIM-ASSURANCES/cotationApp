# =====================================================================
# Variables de docker-compose.yml (déploiement Docker / VPS).
# Copier en « .env » À LA RACINE du dépôt, puis remplir. Jamais commité.
# Ce fichier est distinct de app/.env et generateur/.env, qui servent au développement sans Docker.
# =====================================================================

# Base PostgreSQL créée au premier démarrage.
POSTGRES_USER=sim
POSTGRES_DB=sim_documents

# Mots de passe et secrets : générer chacun avec
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (en hexadécimal : aucun caractère spécial à encoder dans l'adresse de la base).
# Valeurs DIFFÉRENTES sur chaque environnement, jamais celles d'un poste de développement.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Secret partagé application <-> générateur (en-tête X-Generateur-Secret).
GENERATEUR_SECRET=
# Clé de signature des sessions de connexion. La changer déconnecte tout le monde.
AUTH_SECRET=

# Délai maximal d'une conversion PDF, en secondes (défaut : 60).
# DELAI_CONVERSION_S=60
