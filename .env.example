# =====================================================================
# Variables de docker-compose.yml (déploiement Docker / VPS).
# Copier en « .env » À LA RACINE du dépôt, puis remplir. Jamais commité.
# Ce fichier est distinct de app/.env et generateur/.env, qui servent au développement sans Docker.
# =====================================================================

# Base PostgreSQL créée au premier démarrage.
POSTGRES_USER=sim
POSTGRES_DB=sim_documents

# Mots de passe et secrets : générer chacun avec
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# (en hexadécimal : aucun caractère spécial à encoder dans l'adresse de la base).
# Valeurs DIFFÉRENTES sur chaque environnement, jamais celles d'un poste de développement.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Secret partagé application <-> générateur (en-tête X-Generateur-Secret).
GENERATEUR_SECRET=
# Clé de signature des sessions de connexion. La changer déconnecte tout le monde.
AUTH_SECRET=
# Adresse publique de l'application, telle que la voit le public (https://domaine), sans « / » final.
# Les QR codes des documents émis y renvoient : URL_PUBLIQUE/verif/<jeton>. Domaine pas encore connu (D14) :
# tant qu'elle est vide, l'application fonctionne mais refuse d'émettre un document.
URL_PUBLIQUE=

# Port de l'hôte sur lequel l'application est publiée (uniquement sur 127.0.0.1 ; défaut : 3000).
# Le VPS est partagé avec le portail RH : choisir un port libre (ex. 3010) et y faire pointer le proxy inverse.
# APP_PORT=3000

# DÉVELOPPEMENT UNIQUEMENT, jamais sur le VPS : mot de passe des comptes de test du seed de
# développement (docker compose run --rm -e NODE_ENV=development -e AUTORISER_SEED_DEV=oui outils npm run seed:dev).
# Laisser vide sur un serveur.
SEED_MOT_DE_PASSE=

# Délai maximal d'une conversion PDF, en secondes (défaut : 60).
# DELAI_CONVERSION_S=60

# Conversions PDF simultanées (générateur et travailleur), chacune avec son profil LibreOffice (défaut : 2).
# Autour du nombre de processeurs moins un ; T8 (500 certificats) est mesuré avec 2 sur 4 processeurs (docs/recette.md).
# CONVERSIONS_SIMULTANEES=2
