# Réglages communs à tous les éditeurs (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
# En Markdown, deux espaces en fin de ligne forcent un retour à la ligne.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
