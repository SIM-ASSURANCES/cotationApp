# =====================================================================
# Modèle de configuration de l'application (app/).
# Copier ce fichier en « .env » dans le même dossier, puis compléter.
# Le fichier .env n'est JAMAIS commité (voir le .gitignore à la racine).
# Une variable manquante ou invalide arrête l'application au démarrage.
# =====================================================================

# Connexion PostgreSQL, lue par l'application et par la CLI Prisma.
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
# UTILISATEUR : postgres ou un rôle personnel ayant le droit CREATEDB.
# Remplacer MOT_DE_PASSE par le vrai mot de passe, dans .env uniquement.
# Ses caractères spéciaux doivent être encodés pour une URL :
#   @ -> %40   : -> %3A   / -> %2F   # -> %23   % -> %25   $ -> %24
# (le « $ » serait sinon interprété comme une variable par Next.js).
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/sim_documents"

# Adresse du générateur (service Python). Par défaut, il n'écoute que la
# machine locale : doit correspondre à GENERATEUR_HOTE et GENERATEUR_PORT
# de generateur/.env.
GENERATEUR_URL="http://127.0.0.1:8001"

# Secret partagé avec le générateur (en-tête X-Generateur-Secret),
# 32 caractères minimum. Doit être IDENTIQUE à GENERATEUR_SECRET dans
# generateur/.env. Pour en créer un :
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
# Laissé vide exprès : l'application refuse de démarrer tant qu'il manque.
GENERATEUR_SECRET=""

# Clé qui signe les sessions de connexion (Auth.js), 32 caractères minimum.
# Propre à chaque environnement : une clé différente sur le VPS et sur ton poste.
# Pour en créer une :
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
# Changer cette clé déconnecte tout le monde.
AUTH_SECRET=""

# Adresse publique de l'application (https://domaine), base des QR codes des documents émis :
# URL_PUBLIQUE/verif/<jeton>. Facultative : vide, l'application refuse seulement d'émettre un
# document. En développement : http://localhost:3000
URL_PUBLIQUE=""

# Derrière un proxy HTTPS (VPS) : true pour qu'Auth.js fasse confiance à l'adresse
# transmise par le proxy. Inutile en développement.
# AUTH_TRUST_HOST=true

# File de tâches BullMQ (Redis, D24) : import en masse et reprise des écritures différées (T14).
# Facultative pour l'application (sans elle, l'import est contrôlé mais ses certificats attendent le
# travailleur) ; OBLIGATOIRE pour le travailleur (npm run travailleur) et pour npm run test:integration / test:e2e.
# Format : redis://:MOT_DE_PASSE@HOTE:6379 (rediss:// pour une connexion chiffrée).
# REDIS_URL="redis://:MOT_DE_PASSE@127.0.0.1:6379"

# Conversions PDF simultanées d'un import en masse (1 à 16, défaut 2). Même valeur que dans generateur/.env.
# CONVERSIONS_SIMULTANEES=2

# DÉVELOPPEMENT UNIQUEMENT : mot de passe des comptes de test du seed (npm run seed:dev), qui doit
# respecter la politique de mot de passe (12 caractères au moins, pas de mot courant…). Jamais sur
# un serveur. Le seed exige AUSSI AUTORISER_SEED_DEV=oui (voir docs/installation.md §10).
SEED_MOT_DE_PASSE=""
# AUTORISER_SEED_DEV=oui

# OPTIONNEL : base réservée aux tests d'intégration (npm run test:integration).
# Son nom DOIT se terminer par _test ; la créer avec « npm run test:integration:preparer ».
# TEST_DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/sim_documents_test"
